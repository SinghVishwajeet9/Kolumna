# Local development: the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4100

# Hosted (set these on Vercel, not here):
#   API_ORIGIN=https://<your-api>.vercel.app          # where /api/* is forwarded to
#   NEXT_PUBLIC_API_URL=/api                          # the browser calls its own site
#   NEXT_PUBLIC_MCP_URL=https://<your-api>.vercel.app/mcp   # shown to agents
