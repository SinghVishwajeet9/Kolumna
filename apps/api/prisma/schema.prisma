// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum ActorType {
  HUMAN
  AGENT
}

// The primitive everything assignable/attributable references — a Human or
// an Agent, same rights & audit surface, different backing data. Nothing
// downstream (Membership, Card.assignee, later Agent/AuditEntry) points at
// User directly anymore; it points here. See kolumna-architecture.md §0, §4.1.
model Actor {
  id          String    @id @default(cuid())
  type        ActorType
  displayName String
  avatarUrl   String?
  createdAt   DateTime  @default(now())

  user          User?
  agent         Agent?
  ownedAgents   Agent[]      @relation("AgentOwner")
  memberships   Membership[]
  assignedCards Card[]

  auditEntries           AuditEntry[] @relation("AuditActor")
  auditEntriesOnBehalfOf AuditEntry[] @relation("AuditOnBehalfOf")
  comments               Comment[]    @relation("CommentAuthor")
}

model User {
  id             String   @id @default(cuid())
  actorId        String   @unique
  email          String   @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())

  actor    Actor     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  sessions Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per failed login, keyed by the (lowercased) email that was tried —
// whether or not that account exists. 5 failures within 15 minutes lock that
// email until the window passes (lib/loginThrottle.ts, roadmap G10). Kept in
// the database, not memory: the free API host restarts whenever it sleeps.
model LoginFailure {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt]) // pruning old rows
}

model Workspace {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  createdAt          DateTime           @default(now())
  members            Membership[]
  boards             Board[]
  labels             Label[]
  lists              List[]
  cards              Card[]
  agents             Agent[]
  auditEntries       AuditEntry[]
  subtaskProposals   SubtaskProposal[]
  reviews            ConfidenceReview[]
  autonomyPolicies   AutonomyPolicy[]
  comments           Comment[]
  checklistItems     ChecklistItem[]
  epics              Epic[]
  sprints            Sprint[]
  costEvents         CostEvent[]
  modelPrices        ModelPrice[]
  usageBudgets       UsageBudget[]
  agentReliabilities AgentReliability[]
  workspaceInvites   WorkspaceInvite[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id          String        @id @default(cuid())
  actorId     String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  actor     Actor     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([actorId, workspaceId])
  @@index([workspaceId])
}

enum AgentStatus {
  PROVISIONED // registered, but can't authenticate yet — a human must activate it
  ACTIVE // can be issued grants/tokens
  SUSPENDED // temporarily blocked; can be re-activated
  REVOKED // terminal — permanently dead, all grants killed
}

// A registered AI principal. Backed by its own Actor (so it can be a
// Membership and a Card.assignee exactly like a human), but never has a
// password — it authenticates to the gateway via OAuth 2.1 client
// credentials (clientId + clientSecret) instead. See
// kolumna-architecture.md §4.1 and §6.
model Agent {
  id                  String        @id @default(cuid())
  actorId             String        @unique
  workspaceId         String
  ownerActorId        String // which human registered/owns this agent
  modelProvider       String // BYO — "anthropic" | "openai" | ... (no adapter yet, just recorded)
  capabilities        Json // skills/tools this agent offers, free-form for now
  allowedScopes       Json          @default("[]") // ceiling set by the registering human; every grant must be a subset
  status              AgentStatus   @default(PROVISIONED)
  clientId            String        @unique
  hashedClientSecret  String
  createdAt           DateTime      @default(now())
  // G14 — an engagement end, so an agent brought in for a sprint doesn't keep
  // its credential forever. Access ends at accessUntil, or when accessSprint
  // is completed, whichever comes first. Enforced at grant issuance
  // (agentGrant.repo.ts); completing the sprint revokes its live grants.
  accessUntil         DateTime?
  accessSprintId      String?
  // Phase 4 — graduated trust. The default for every board; AutonomyPolicy
  // overrides it per board. New agents start ACT_WITH_APPROVAL.
  autonomyLevel       AutonomyLevel @default(ACT_WITH_APPROVAL)
  confidenceThreshold Float         @default(0.8) // ACT_WITH_APPROVAL acts on its own only at or above this

  actor              Actor              @relation(fields: [actorId], references: [id], onDelete: Cascade)
  accessSprint       Sprint?            @relation(fields: [accessSprintId], references: [id], onDelete: SetNull)
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner              Actor              @relation("AgentOwner", fields: [ownerActorId], references: [id])
  grants             AgentGrant[]
  autonomyPolicies   AutonomyPolicy[]
  reviews            ConfidenceReview[]
  costEvents         CostEvent[]
  budgets            UsageBudget[]
  agentReliabilities AgentReliability[]

  @@index([workspaceId])
}

enum AutonomyLevel {
  SUGGEST_ONLY // every gated write waits for a human
  ACT_WITH_APPROVAL // acts when its stated confidence clears the threshold, else waits
  ACT_AUTONOMOUS // acts directly, still fully audited
}

// Per-board override of an agent's autonomy ("trusted on the docs board,
// supervised on payments").
model AutonomyPolicy {
  id                  String        @id @default(cuid())
  workspaceId         String
  agentId             String
  boardId             String
  level               AutonomyLevel
  confidenceThreshold Float? // null = the agent's own
  updatedAt           DateTime      @updatedAt
  createdAt           DateTime      @default(now())

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  board     Board     @relation(fields: [boardId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([agentId, boardId])
  @@index([workspaceId])
}

enum ReviewStatus {
  PENDING
  APPROVED // and it ran
  REJECTED
  FAILED // approved, but it could no longer run (e.g. the card was reassigned)
}

enum ReviewReason {
  AUTONOMY_LEVEL // the agent may only suggest here
  LOW_CONFIDENCE // below the threshold, or no confidence given
  BUDGET_EXCEEDED // Phase 5: a budget that covers it is used up
}

// A gated agent action waiting for a human. Holds the exact tool call; on
// approval it runs as the agent, on the approver's authority.
model ConfidenceReview {
  id                String       @id @default(cuid())
  workspaceId       String
  agentId           String
  boardId           String
  cardId            String?
  toolName          String
  input             Json // validated tool input, minus confidence/reasoning
  summary           String // what a human is approving, in words
  confidence        Float?
  reasoning         String?
  reason            ReviewReason
  status            ReviewStatus @default(PENDING)
  onBehalfOfActorId String? // whose authority the agent was acting under when it asked
  reviewerActorId   String?
  decidedAt         DateTime?
  note              String? // reviewer's note on rejection
  result            Json? // the tool's output, once approved
  error             String? // why it FAILED
  createdAt         DateTime     @default(now())

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  card      Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([agentId, status])
}

// One issued access token. Same "never store the raw secret" pattern as
// Session (lib/session.ts) — tokenHash is what's persisted, the raw token is
// only ever seen once, at issuance. expiresAt is short-lived by design: this
// is the "ephemeral agent, permanent credential" bug fix — access dies on
// schedule with no separate revocation step required (though explicit
// revocation, e.g. via Agent.status, is also supported).
enum AgentGrantKind {
  CLIENT_CREDENTIALS // POST /agent-auth/token — an external agent asked for a bearer token
  MCP_SESSION // a connected MCP client (Claude Code, Codex…), reused across its requests
  HOSTED_RUN // Kolumna's own worker running the agent (Path B)
}

model AgentGrant {
  id              String         @id @default(cuid())
  kind            AgentGrantKind @default(CLIENT_CREDENTIALS)
  agentId         String
  workspaceId     String
  scopes          Json // string[] of granted scope names
  tokenHash       String         @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  issuedByActorId String
  createdAt       DateTime       @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([workspaceId])
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// The "agent proposes, human approves" holding pen. AuditEntry records THAT
// a proposal happened (append-only, immutable); this table is where the
// proposal itself lives so it can transition PENDING -> APPROVED/REJECTED —
// a state change that has no place in an append-only log. Approving one
// creates real Card rows in the same list as the parent card; nothing here
// mutates the board until that happens.
model SubtaskProposal {
  id                String         @id @default(cuid())
  workspaceId       String
  cardId            String // the parent ticket these subtasks were proposed for
  proposedByActorId String // the agent's actor id
  runId             String?        @unique // the hosted run that made it — a retried run finds this instead of duplicating
  subtasks          Json // array of { title: string } — the model's proposed breakdown
  reasoningSummary  String? // the model's own "why" — same idea as AuditEntry's field
  status            ProposalStatus @default(PENDING)
  reviewedByActorId String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cardId])
}

// Append-only, tamper-evident log of every attributable action — the #1
// differentiator (kolumna-architecture.md §4.2). Every entry's hash commits
// to the previous entry's hash (SHA-256(prevHash + canonical(entry))), so
// altering or deleting a past entry breaks the chain from that point
// forward — detectable, not just theoretically wrong. See lib/audit.ts for
// the writer/verifier. Rows are never updated or deleted by app code.
model AuditEntry {
  id                String   @id @default(cuid())
  workspaceId       String
  seq               Int // per-workspace monotonic sequence — the chain's order
  actorId           String // who acted (human or agent)
  onBehalfOfActorId String? // delegation: whose authority it used, if any
  action            String // e.g. "CARD.ASSIGN", "AGENT.ACTIVATE"
  targetType        String // e.g. "Card", "Agent"
  targetId          String
  toolInvoked       String? // which MCP tool/operation, once those exist (Phase 3+)
  resource          String? // an external resource touched, if any
  result            String // SUCCESS | DENIED | PENDING_APPROVAL | ERROR
  reasoningSummary  String? // the agent's own "why" — null for human actions
  confidence        Float? // agent's stated confidence 0..1 — Phase 4+
  model             String? // which model produced this action — Phase 3+
  tokensIn          Int?
  tokensOut         Int?
  costUsd           Float?
  prevHash          String // the previous entry's hash, or the genesis hash if seq 1
  hash              String   @unique
  createdAt         DateTime // set by the app (not @default) so it's part of what's hashed

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      Actor     @relation("AuditActor", fields: [actorId], references: [id])
  onBehalfOf Actor?    @relation("AuditOnBehalfOf", fields: [onBehalfOfActorId], references: [id])

  @@unique([workspaceId, seq])
  @@index([workspaceId])
  @@index([targetType, targetId])
}

// A note on a card from a human or an agent — how a connected agent reports
// what it's doing. Phase 7 grows this into per-card threads.
model Comment {
  id            String   @id @default(cuid())
  workspaceId   String
  cardId        String
  authorActorId String
  body          String
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author    Actor     @relation("CommentAuthor", fields: [authorActorId], references: [id])

  @@index([cardId])
  @@index([workspaceId])
}

// The steps of a card. % complete is COMPUTED from these (done / total) —
// never a number an agent types in. Created by an agent directly or from an
// approved SubtaskProposal (sourceProposalId).
model ChecklistItem {
  id               String    @id @default(cuid())
  workspaceId      String
  cardId           String
  title            String
  rank             Float
  done             Boolean   @default(false)
  doneAt           DateTime?
  doneByActorId    String?
  evidenceUrl      String? // commit / branch / PR / test run backing the tick — verified in Phase 8
  createdByActorId String
  sourceProposalId String?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([workspaceId])
}

model Label {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  color       String
  createdAt   DateTime    @default(now())
  cardLabels  CardLabel[]
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

model Board {
  id               String           @id @default(cuid())
  workspaceId      String
  title            String
  // Prefix for card keys (PRM-1, PRM-2…), unique within the workspace.
  key              String
  // Atomic per-board counter for card numbers — incremented in the same
  // statement that hands the number out, so concurrent creates never collide.
  nextCardNumber   Int              @default(1)
  createdAt        DateTime         @default(now())
  lists            List[]
  cards            Card[]
  sprints          Sprint[]
  epics            Epic[]
  autonomyPolicies AutonomyPolicy[]
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@unique([id, workspaceId]) // target of composite foreign keys below
  @@index([workspaceId])
}

model List {
  id          String    @id @default(cuid())
  boardId     String
  workspaceId String
  title       String
  rank        Float
  createdAt   DateTime  @default(now())
  cards       Card[]
  // Composite FK: a list's board must be in the SAME workspace (roadmap G12).
  board       Board     @relation(fields: [boardId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([id, boardId, workspaceId]) // target of Card's composite FK
  @@index([boardId])
  @@index([workspaceId])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Card {
  id               String             @id @default(cuid())
  listId           String
  boardId          String
  workspaceId      String
  number           Int // with the board key → "PRM-3"
  title            String
  rank             Float
  description      String?
  dueDate          DateTime?
  priority         Priority           @default(NONE)
  storyPoints      Int?
  reviewThreshold  Float? // Phase 4: agent changes below this confidence need a human, whatever its autonomy
  // Phase 6 — when the card last reached the board's done column, and whose
  // work it was (the assignee at that moment). Drives burndown and agent
  // reliability; cleared when the card leaves done (a reopen, audited).
  doneAt           DateTime?
  doneAssigneeId   String?
  epicId           String?
  sprintId         String? // null = in the backlog
  createdAt        DateTime           @default(now())
  cardLabels       CardLabel[]
  assigneeId       String?
  assignee         Actor?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  // Composite FKs — the DATABASE guarantees a card's list is on the card's own
  // board, in the card's own workspace. The app-level check from the
  // 2026-10-13 cross-tenant move bug is now a backstop, not the only line.
  list             List               @relation(fields: [listId, boardId, workspaceId], references: [id, boardId, workspaceId], onDelete: Cascade)
  board            Board              @relation(fields: [boardId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  epic             Epic?              @relation(fields: [epicId], references: [id], onDelete: SetNull)
  sprint           Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  subtaskProposals SubtaskProposal[]
  reviews          ConfidenceReview[]
  comments         Comment[]
  checklistItems   ChecklistItem[]
  costEvents       CostEvent[]

  @@unique([boardId, number])
  @@index([listId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([epicId])
}

model Epic {
  id          String      @id @default(cuid())
  workspaceId String
  boardId     String
  title       String
  description String?
  color       String      @default("#c4b5fd")
  createdAt   DateTime    @default(now())
  cards       Card[]
  board       Board       @relation(fields: [boardId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  costEvents  CostEvent[]

  @@index([boardId])
  @@index([workspaceId])
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

// At most ONE active sprint per board — enforced by a partial unique index
// added by hand in the migration (Prisma can't express WHERE in @@unique).
model Sprint {
  id                 String             @id @default(cuid())
  workspaceId        String
  boardId            String
  name               String
  goal               String?
  status             SprintStatus       @default(PLANNED)
  startsAt           DateTime?
  endsAt             DateTime?
  completedAt        DateTime?
  // Phase 6 — blended capacity: the humans' hours for this sprint; the
  // agents' side is its UsageBudget. carriedOverPoints is snapshotted at
  // completion (unfinished cards leave the sprint then).
  humanCapacityHours Float?
  carriedOverPoints  Int?
  createdAt          DateTime           @default(now())
  cards              Card[]
  boundAgents        Agent[] // agents whose access ends when this sprint is completed (G14)
  board              Board              @relation(fields: [boardId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  costEvents         CostEvent[]
  usageBudgets       UsageBudget[]
  agentReliabilities AgentReliability[]

  @@index([boardId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Phase 5 — cost accounting. Money is Decimal, never Float.

enum CostSource {
  SELF_REPORTED // a connected agent told us (report_usage) — Kolumna can't see inside its session
  HOSTED_RUN // Kolumna's own worker ran the model (Path B) — exact
  MANUAL // a human logged it (e.g. from Claude Code's /cost)
}

// One unit of spend. Card/board/sprint/epic are SNAPSHOTS taken when it was
// incurred, so a sprint's cost stays what it was even if the card moves on.
model CostEvent {
  id                String     @id @default(cuid())
  workspaceId       String
  agentId           String?
  actorId           String // who incurred it (usually the agent's actor)
  cardId            String?
  boardId           String?
  sprintId          String?
  epicId            String?
  source            CostSource
  model             String?
  tokensIn          Int        @default(0)
  tokensOut         Int        @default(0)
  costUsd           Decimal?   @db.Decimal(14, 6) // null = unknown (no price for the model)
  note              String?
  reportedByActorId String
  createdAt         DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  card      Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  sprint    Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic      Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([sprintId])
  @@index([epicId])
  @@index([cardId])
  @@index([agentId, createdAt])
}

// What a model costs, per workspace (prices change and differ by contract).
// Used to price token counts that arrive without a dollar figure.
model ModelPrice {
  id               String   @id @default(cuid())
  workspaceId      String
  model            String
  inputPerMTokUsd  Decimal  @db.Decimal(12, 6)
  outputPerMTokUsd Decimal  @db.Decimal(12, 6)
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, model])
}

// A spending limit. Scope by which ids are set:
//   sprintId            → that sprint, for its whole life
//   agentId             → that agent, per calendar month
//   neither             → the whole workspace, per calendar month
// Crossing alertAt is recorded once (BUDGET.ALERT); crossing the cap marks it
// exceeded, and from then on the agents it covers can only act through a
// human review — Kolumna can't stop a model it doesn't run, but it can stop
// that model's changes landing unreviewed.
model UsageBudget {
  id          String    @id @default(cuid())
  workspaceId String
  sprintId    String?
  agentId     String?
  costCapUsd  Decimal?  @db.Decimal(14, 2)
  tokenCap    Int?
  alertAt     Float     @default(0.8)
  alertedAt   DateTime?
  exceededAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint?   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Phase 6 — an agent's track record for one completed sprint. Snapshotted at
// completion so the trend survives later edits; the live 30-day view is
// computed on demand. It informs autonomy promotion — a human still decides.
model AgentReliability {
  id              String   @id @default(cuid())
  workspaceId     String
  agentId         String
  sprintId        String
  cardsDone       Int
  pointsDone      Int
  reopened        Int // its done cards that were later reopened
  reviewsDecided  Int
  reviewsApproved Int
  approvalRate    Float? // null when nothing was decided
  reopenRate      Float? // null when it finished nothing
  avgConfidence   Float? // what it claimed on reviewed changes
  deniedCalls     Int
  toolCalls       Int
  costUsd         Decimal? @db.Decimal(14, 6)
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([agentId, sprintId])
  @@index([workspaceId])
}

// An invitation to join a workspace. The link carries a random token; only
// its SHA-256 hash is stored (same pattern as sessions and agent secrets),
// so a leaked database can't be turned into working invite links. One use,
// expires after 7 days, bound to the invited email address.
model WorkspaceInvite {
  id                String        @id @default(cuid())
  workspaceId       String
  email             String // lower-cased; only this address can accept
  role              WorkspaceRole @default(MEMBER) // ADMIN or MEMBER — ownership isn't handed out by link
  tokenHash         String        @unique
  invitedByActorId  String
  expiresAt         DateTime
  acceptedAt        DateTime?
  acceptedByActorId String?
  revokedAt         DateTime?
  createdAt         DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}
