# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

PORT=4100

# Frontend origin allowed to make cross-origin requests (see CORS, CONCEPTS.md §2.7)
CORS_ORIGIN=http://localhost:3000

# Neon connection string — get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis — backs the BullMQ agent-run queue. Local dev: run
#   docker run -d --name kolumna-redis -p 6379:6379 -v kolumna-redis-data:/data redis:7-alpine redis-server --appendonly yes
REDIS_URL=redis://localhost:6379
